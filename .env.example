# Auth.js session-encryption secret.
# Generate with:  npx auth secret      (writes to .env.local automatically)
# or:             openssl rand -base64 33
AUTH_SECRET=

# Google OAuth 2.0 client credentials.
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Neon serverless Postgres connection string (Phase 1+).
# Neon Console -> your project -> Connection Details -> copy the
# "Pooled connection" string (postgresql://...neon.tech/<db>?sslmode=require).
DATABASE_URL=
